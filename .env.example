# Arbitrage Finder Environment Configuration

# ==============================================
# REQUIRED: Odds API Configuration
# ==============================================
# Get your free API key from https://the-odds-api.com
ODDS_API_KEY=your_odds_api_key_here

# ==============================================
# OPTIONAL: Discord Notifications
# ==============================================
# Create a webhook in your Discord server settings
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here

# ==============================================
# DATABASE CONFIGURATION (Docker)
# ==============================================
# These settings work with the included docker-compose.yml
# No changes needed for Docker deployment
DB_HOST=postgres
DB_PORT=5432
DB_NAME=arbitrage_finder
DB_USER=arbitrage_user
DB_PASSWORD=arbitrage_password

# ==============================================
# DATABASE CONFIGURATION (Local Development)
# ==============================================
# Uncomment and modify for local PostgreSQL
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=arbitrage_finder
# DB_USER=your_local_db_user
# DB_PASSWORD=your_local_db_password

# ==============================================
# OPTIONAL: API Upload Configuration
# ==============================================
# Only needed if using custom API endpoints
# CLIENT_ID=your_client_id_here
# CLIENT_SECRET=your_client_secret_here
# API_ENDPOINT=your_api_endpoint_here
